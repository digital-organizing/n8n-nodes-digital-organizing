{
  "name": "n8n-nodes-digital-organizing",
  "version": "0.1.0",
  "description": "n8n community nodes for the tools Digital Organizing works with: Payrexx, RaiseNow, Cura Fundraising and our own Do Counter",
  "license": "MIT",
  "homepage": "https://github.com/digital-organizing/n8n-nodes-digital-organizing",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "payrexx",
    "raisenow",
    "cura",
    "libracore",
    "fundraising"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "author": {
    "name": "Sandro Covo",
    "email": "sandro@digitalorganizing.ch"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/digital-organizing/n8n-nodes-digital-organizing.git"
  },
  "bugs": {
    "url": "https://github.com/digital-organizing/n8n-nodes-digital-organizing/issues"
  },
  "engines": {
    "node": ">=20.15"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "format": "prettier --write \"{credentials,nodes}/**/*.ts\"",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/DoCounterApi.credentials.js",
      "dist/credentials/PayrexxApi.credentials.js",
      "dist/credentials/RaiseNowApi.credentials.js",
      "dist/credentials/CuraApi.credentials.js",
      "dist/credentials/LibraCoreApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/DoCounter/DoCounter.node.js",
      "dist/nodes/Payrexx/Payrexx.node.js",
      "dist/nodes/PayrexxTrigger/PayrexxTrigger.node.js",
      "dist/nodes/RaiseNow/RaiseNow.node.js",
      "dist/nodes/RaiseNowTrigger/RaiseNowTrigger.node.js",
      "dist/nodes/Cura/Cura.node.js",
      "dist/nodes/LibraCore/LibraCore.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "eslint": "9.39.4",
    "prettier": "3.8.3",
    "release-it": "20.0.1",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
